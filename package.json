{
  "name": "wcag-front",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "quality": "npm run check && npm run test:unit && npm run test:e2e && npm run test:a11y && npm run test:visual",
    "test": "npm run test:e2e",
    "test:e2e": "playwright test",
    "test:unit": "vitest run src/lib/payload.test.ts",
    "test:a11y": "npm run build && playwright test --config playwright.a11y.config.ts",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.7",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/atkinson-hyperlegible": "^5.2.6",
    "@fontsource/lato": "^5.2.6",
    "@fontsource/satisfy": "^5.2.6",
    "@tailwindcss/vite": "^4.2.4",
    "a11ying-ui": "github:calydia/a11ying-ui#v2.0.11",
    "astro": "^6.4.3",
    "astro-icon": "^1.1.5",
    "dayjs": "^1.11.21",
    "qs-esm": "^8.0.1",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "vite": "7.3.2",
    "yaml-language-server": {
      "yaml": "2.9.0"
    }
  }
}
