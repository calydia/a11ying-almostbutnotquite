{
  "name": "wcag-front",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "quality": "npm run check && npm run test:unit && npm run test:e2e && npm run test:a11y && npm run test:visual",
    "test": "npm run test:e2e",
    "test:e2e": "playwright test",
    "test:unit": "vitest run src/lib/payload.test.ts",
    "test:a11y": "npm run build && playwright test --config playwright.a11y.config.ts",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.8",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/satisfy": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "a11ying-ui": "github:calydia/a11ying-ui#v2.0.15",
    "astro": "^7.4.11",
    "astro-icon": "^1.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "yaml-language-server": {
      "yaml": "2.9.0"
    }
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
